root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

# Markdown 里行尾两个空格是硬换行，别让编辑器吃掉。
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
